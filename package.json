{
  "name": "oandocraft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "build:oando": "tsc -b && vite build --base=/OandOcraft/",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test:browserstack": "npx browserstack-node-sdk playwright test",
    "test:browserstack:percy": "npm run test:browserstack",
    "audit:pages": "node scripts/audit-pages.cjs",
    "release:manifest": "node scripts/create_release_manifest.cjs",
    "seed:pull": "node scripts/generate_full_seed.cjs",
    "seed:counts": "node scripts/report_public_table_counts.cjs",
    "seed:verify": "node scripts/verify_seed_payload.cjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.104.1",
    "@svgdotjs/svg.js": "^3.2.5",
    "@tanstack/react-query": "^5.100.5",
    "@tanstack/react-virtual": "^3.13.24",
    "clsx": "^2.1.1",
    "dockview-react": "^5.2.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "konva": "^10.2.5",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.1.9",
    "papaparse": "^5.5.3",
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.18.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-konva": "^19.2.3",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.1",
    "browserstack-node-sdk": "^1.53.0",
    "canvas": "^3.2.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "supabase": "^2.95.3",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
